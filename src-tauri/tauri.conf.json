{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dictapad",
  "version": "0.1.1",
  "identifier": "com.guojunnan.dictapad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dictapad",
        "width": 400,
        "height": 500,
        "minWidth": 280,
        "minHeight": 200,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true,
        "skipTaskbar": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGMDgwQkI3MDAxRUM5RTUKUldUbHlSNEF0d3NJZjdzMFVVS2YvcWdiOGFhc2NjK09PNmJsS3UyQTNtM1lMT1ZGY0ZEZk8wS0QK",
      "endpoints": [
        "https://github.com/FreeJolan/dictapad/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Floating Markdown scratchpad for voice dictation",
    "longDescription": "A lightweight always-on-top WYSIWYG Markdown editor designed as a relay station for voice dictation workflows."
  }
}
